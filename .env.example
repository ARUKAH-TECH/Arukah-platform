# ARUKAH Platform — environment variable reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ---------------------------------------------------------------------------
# Site
# Server-only (no NEXT_PUBLIC_ prefix) — only read in server code
# (layout metadata, sitemap.ts, robots.ts), never in the browser.
# ---------------------------------------------------------------------------
SITE_URL=

# ---------------------------------------------------------------------------
# Database (Phase 8+)
# PostgreSQL-compatible. Works with Supabase, AWS Aurora Postgres, or
# standard Postgres. Keep business logic vendor-agnostic where possible.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (Phase 8+, if used as the managed Postgres/auth provider)
# NEXT_PUBLIC_* keys are safe for the browser. The service role key is
# server-only, must never be exposed to the client, and must never be
# committed to git.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Caching (Phase 15+)
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Object storage (Phase 12+, S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Email / notifications (Phase 8+, for contact form + enquiry system)
# ---------------------------------------------------------------------------
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Observability (Phase 15+)
# ---------------------------------------------------------------------------
SENTRY_DSN=
